* {
  padding: 0;
  margin: 0;
  font-family: "SF Pro Text";
  font-weight: bold;
  font-size: 15px;
  color: #ffffff;
}

window#waybar {
  background-color: rgba(225, 230, 249, 0.15);
}

#window {
  margin-left: 5px;
  margin-top: 1px;
  background-color: transparent;
}

#custom-launcher {
  font-size: 15px;
  color: #f38ba8;
  padding-right: 15px;
}

#cpu,
#memory,
#temperature {
  font-size: 15px;
  margin-bottom: -20px;
}

#cpu {
  color: #f38ba8;
  padding: 0 10px 0 12px;
  border-radius: 5px 0 0 5px;
}

#memory {
  color: #a6e3a1;
  padding: 0 10px 0 0;
}

#temperature {
  color: #89b4fa;
  padding: 0 12px 0 0;
  border-radius: 0 5px 5px 0;
}

#custom-window-name {
  font-size: 15px;
  color: #89b4fa;
  margin-right: 10px;
  background-color: #313244;
}

#workspaces {
  margin-left: 7px;
}

#workspaces button {
  all: initial;
  font-size: 15px;
  padding: 2px 6px;
  margin-right: 3px;
}

#box {
  background-color: transparent;
  border-radius: 12px;
}

#battery,
#pulseaudio,
#custom-notification {
  font-size: 15px;
  padding: 0 5px;
  padding-left: 5px;
}

#mpris {
  font-size: 15px;
  font-weight: normal;
  padding: 0 10px;
  margin: 5px;
  border-radius: 5px;
  animation: blink 3s linear infinite alternate;
}

#custom-update {
  font-size: 15px;
  color: #94e2d5;
  padding-left: 5px;
}

#custom-mic {
  font-size: 15px;
  color: #94e2d5;
  padding-left: 5px;
}

#custom-timer {
  font-size: 15px;
  padding-left: 5px;
}

#backlight {
  font-size: 15px;
  color: #f9e2af;
}

#custom-right-arr {
  font-size: 15px;
  color: #cdd6f4;
  background-color: #313244;
}

#custom-dot {
  font-size: 15px;
  color: #bac2de;
  padding-right: 10px;
  background-color: #313244;
}

#custom-dot-alt {
  font-size: 15px;
  color: #a6adc8;
  padding: 0 10px;
}

#disk {
  font-size: 15px;
  color: #89b4fa;
  background-color: #313244;
}

#custom-clock-icon {
  font-size: 15px;
  color: #cdd6f4;
  padding: 0 10px;
  margin: 5px 0;
  border-radius: 5px;
}

#custom-filler,
#custom-filler2 {
  font-size: 15px;
  color: #bac2de;
  padding: 0 9px;
  margin: 5px 0;
  border-radius: 5px;
}

#clock {
  font-size: 15px;
  padding: 0 10px;
  font-weight: normal;
}

#custom-reboot,
#custom-power,
#custom-quit {
  font-size: 15px;
  margin: 5px;
  padding: 0 3px;
}

#custom-reboot {
  color: #a6e3a1;
}

#custom-power {
  color: #f9e2af;
}

#battery.charging {
  color: #94e2d5;
}

#custom-quit {
  color: #f38ba8;
}

#custom-log {
  font-size: 15px;
  margin: 1px;
}

menu {
  font-size: 15px;
  border-radius: 10px;
  background: #1e1e2e;
  font-weight: bold;
}

#pulseaudio-slider slider {
  font-size: 15px;
  min-height: 0;
  min-width: 0;
  opacity: 0;
  border: none;
  box-shadow: none;
  color: #f9e2af;
}

#pulseaudio-slider trough {
  font-size: 15px;
  min-height: 8px;
  min-width: 100px;
  border-radius: 10px;
  margin-right: 5px;
  color: #f9e2af;
  border: none;
}

#pulseaudio-slider highlight {
  font-size: 15px;
  min-width: 10px;
  border-radius: 5px;
  border: none;
  background-color: #f9e2af;
  color: #f9e2af;
}

@keyframes blink {
  to {
    color: #6c7086;
  }
}
