{
  "layer": "top",
  "position": "bottom",
  "height": 20,
  "modules-left": [
    "sway/workspaces",
    "hyprland/mode"
  ],
  "modules-center": [],
  "modules-right": [
    "mpd",
    // "custom/separator1",
    "mpris",
    "custom/separator1",
    "idle_inhibitor",
    "custom/separator1",
    "custom/fake_ip",
    "custom/separator1",
    "custom/ram",
    "custom/separator1",
    "custom/cpu_temp",
    "custom/separator1",
    "custom/ssd_temp",
    "custom/separator1",
    "custom/rust_love",
    "custom/separator1",
    "pulseaudio",
    "custom/separator1",
    "backlight",
    "custom/separator1",
    "battery",
    "custom/separator1",
    "clock",
    "custom/separator1",
    "tray"
  ],
  "custom/ram": {
    "format": "Ram: {}",
    "exec": "free -h | awk '/Mem:/ {print $3\"/\"$2}'",
    "interval": 5,
    "tooltip": false
  },
  "custom/cpu_temp": {
    "format": "Tea: {}°C",
    "exec": "echo $(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))",
    "interval": 5,
    "tooltip": false
  },
  "custom/ssd_temp": {
    "format": "Ssd: {}°C",
    "exec": "cat /sys/class/hwmon/hwmon*/temp1_input 2>/dev/null | head -n1 | awk '{print int($1/1000)}'",
    "interval": 30,
    "tooltip": false
  },
  "custom/rust_love": {
    "format": "<span color='red'>❤ 私は Rust が大好き ❤</span>",
    "tooltip": false
  },
  "custom/fake_ip": {
    "format": "<span color='green'>偽のIPアドレス: 192.168.123.45 (1000 Mibt/s)</span>",
    "tooltip": false
  },
  "custom/separator1": {
    "format": "|",
    "tooltip": false
  },
  "hyprland/mode": {
    "format": "{}"
  },
  "battery": {
    "bat": "BAT1",
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon}{capacity}%",
    "rotate": 0,
    "format-charging": " 􀢋<span>{capacity}% Charging</span>",
    "format-plugged": "􀛨 <span>{capacity}%</span>",
    "tooltip-format": "{time} remaining ({capacity}%)",
    "format-icons": [
      " 􀛪 ",
      " 􀛩 ",
      " 􀺶 ",
      " 􀺸 ",
      " 􀛨 "
    ],
    "on-click-right": "pkill waybar && hyprctl dispatch exec waybar"
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "pulseaudio": {
    "format": "{icon} ボリューム: {volume}%",
    "rotate": 0,
    "format-muted": "􀊣 ボリューム: 0%", // Muted display
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "􀪷",
      "hands-free": "􀪷",
      "headset": "􀪷",
      "phone": "􀪷",
      "portable": "􀪷",
      "car": "󪤬",
      "default": [
        "􀊡", // 0–33%
        "􀊥", // 34–65%
        "􀊧", // 66–99%
        "􀊩" // 100%
      ]
    }
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "明るさ: {percent}%",
    "format-icons": []
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "<span  color='green'>オーラ＋</span>",
      "deactivated": "<span  color='red'>オーラー</span>"
    },
    "timeout": 30.5
  },
  // "hyprland/workspaces": {
  //   "format": "<span font='8px'>{icon}</span>",
  //   "format-icons": {
  //     "1": "一",
  //     "2": "二",
  //     "3": "三",
  //     "4": "四",
  //     "5": "五"
  //   }
  // }
  // "mpd": {
  //   "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ",
  //   "format-disconnected": "Disconnected ",
  //   "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
  //   "interval": 2,
  //   "consume-icons": {
  //     "on": " " // Icon shows only when "consume" is on
  //   },
  //   "random-icons": {
  //     "off": "<span color=\"#f53c3c\"> </span>",
  //     "on": " "
  //   },
  //   "repeat-icons": {
  //     "on": " "
  //   },
  //   "single-icons": {
  //     "on": "1 "
  //   },
  //   "state-icons": {
  //     "paused": "",
  //     "playing": ""
  //   },
  //   "tooltip-format": "MPD (connected)",
  //   "tooltip-format-disconnected": "MPD (disconnected)"
  // },
  "mpris": {
    "format": "􀑪 ",
    "format-paused": "􀑪 ",
    "player-icons": {
      "default": "􀑪 ", // your music symbol
      "mpv": "󰝚",
      "spotify": "󰓇"
    },
    "status-icons": {
      "playing": "􀊈", // play icon
      "paused": "􀊈"
    },
    "dynamic-len": 30,
    "title-len": 20,
    "artist-len": 15,
    "scroll": true,
    "tooltip": false,
    "on-click": "playerctl play-pause"
  },
  "mpd": {
    "format": "􀑪 {title:.10}",
    "format-stopped": "",
    "format-disconnected": "",
    "interval": 2,
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)",
    "on-click": "mpc toggle"
  }
}
